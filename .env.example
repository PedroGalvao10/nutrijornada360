# ── Obrigatórias em produção (o servidor NÃO SOBE sem elas com NODE_ENV=production) ──
# Gere com: openssl rand -hex 32  (ou node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
ADMIN_EMAIL=
# Hash bcrypt da senha do admin. Gere com:
# node -e "console.log(require('bcrypt').hashSync('SUA_SENHA', 12))"
ADMIN_PASSWORD_HASH=

# ── Site ──
# URL pública do site (usada em CORS, canonical e sitemap)
SITE_URL=https://marianabermudes.com.br

# ── E-mail (Nodemailer) ──
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=

# ── APIs de nutrição ──
USDA_API_KEY=
SPOONACULAR_API_KEY=

# ── Analytics ──
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Leads (proxy Google Sheets) ──
VITE_GOOGLE_SHEETS_WEBHOOK_URL=

# ── Integração NotebookLM (OPCIONAL — sem estes paths, /api/ai/chat responde 503) ──
NLM_PROXY_PATH=
PYTHON_PATH=
NLM_DEFAULT_NOTEBOOK_ID=
